<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet packages for SRMidiServices (the Windows MIDI Services helper).
  Windows.Devices.Midi2 is a preview package that isn't on nuget.org: tools\Get-WindowsMidiServicesSdk.ps1
  downloads it from Microsoft's GitHub releases into packages-local\. See README.md.
-->
<configuration>
  <config>
    <add key="repositoryPath" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="WindowsMidiServicesLocal" value="packages-local" />
  </packageSources>
</configuration>
