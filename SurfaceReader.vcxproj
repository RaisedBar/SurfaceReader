  <!-- SRMidiServices.exe manages Windows MIDI Services loopbacks in a separate process, so a failure in the
       preview Windows MIDI Services SDK can't take SurfaceReader down. It needs the NuGet packages: see README.md. -->
  <ItemGroup>
    <!-- Only when its NuGet packages have been restored; otherwise SurfaceReader builds without it (see the warning below) -->
    <ProjectReference Include="SRMidiServices\SRMidiServices.vcxproj" Condition="Exists('$(MSBuildThisFileDirectory)packages\Windows.Devices.Midi2.0.99.92-preview.11\build\native\Windows.Devices.Midi2.targets')">
      <Project>{6A2F4E61-1B7C-4C8E-9D2B-5F0C3A7E9B14}</Project>
      <SetPlatform>Platform=x64</SetPlatform>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
    </ProjectReference>
  </ItemGroup>
  <!-- The screen reader DLLs and help file SurfaceReader needs at run time, which the installer puts next to it -->
  <Target Name="CopyRuntimeFiles" AfterTargets="Build">
    <ItemGroup>
      <SurfaceReaderRuntimeFiles Include="$(MSBuildThisFileDirectory)Files\Program Files\*.dll;$(MSBuildThisFileDirectory)Files\Program Files\*.chm" />
    </ItemGroup>
    <Copy SourceFiles="@(SurfaceReaderRuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMidiServicesHelper" AfterTargets="Build">
    <PropertyGroup>
      <MidiServicesHelperDir>$(MSBuildThisFileDirectory)files\x64\$(Configuration)\</MidiServicesHelperDir>
    </PropertyGroup>
    <ItemGroup>
      <MidiServicesHelperFiles Include="$(MidiServicesHelperDir)SRMidiServices.exe;$(MidiServicesHelperDir)Windows.Devices.Midi2.dll;$(MidiServicesHelperDir)Windows.Devices.Midi2.pri" />
    </ItemGroup>
    <Warning Condition="!Exists('$(MidiServicesHelperDir)SRMidiServices.exe')" Text="SRMidiServices.exe hasn't been built, so SurfaceReader won't use Windows MIDI Services. See README.md." />
    <Copy Condition="Exists('$(MidiServicesHelperDir)SRMidiServices.exe')" SourceFiles="@(MidiServicesHelperFiles)" DestinationFolder="$(OutDir)MidiServices\" SkipUnchangedFiles="true" />
  </Target>
